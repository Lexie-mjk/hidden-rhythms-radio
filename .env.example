# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ces variables sont préfixées EXPO_PUBLIC_ car elles sont lues côté client (app mobile).
# Ce sont des identifiants publics par nature (client_id SoundCloud, clé anonyme Supabase
# protégée par des règles RLS en lecture seule) : aucun secret serveur n'est stocké ici.

# Client ID de l'app SoundCloud enregistrée (tableau de bord SoundCloud > Vos apps)
EXPO_PUBLIC_SOUNDCLOUD_CLIENT_ID=

# URL du profil SoundCloud du collectif (Hidden Rhythms) — ses playlists publiques
# alimentent automatiquement l'onglet Playlist.
EXPO_PUBLIC_SOUNDCLOUD_ACCOUNT_URL=https://soundcloud.com/hidden-rhythms

# Project URL et clé "anon public" du projet Supabase (Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NE PAS mettre le client_secret SoundCloud ici (jamais de préfixe EXPO_PUBLIC_ pour un secret :
# il serait embarqué dans le bundle livré à tous les utilisateurs). Il se configure côté serveur,
# pour la Edge Function soundcloud-proxy, avec :
#   supabase secrets set SOUNDCLOUD_CLIENT_ID=... SOUNDCLOUD_CLIENT_SECRET=...

# Idem pour Cloudflare R2 (hébergement des fichiers audio/pochettes, voir la Edge Function
# r2-upload-url) : jamais côté client, uniquement via secrets Supabase :
#   supabase secrets set R2_ACCOUNT_ID=... R2_ACCESS_KEY_ID=... R2_SECRET_ACCESS_KEY=... \
#     R2_BUCKET_NAME=... R2_PUBLIC_URL_BASE=...
