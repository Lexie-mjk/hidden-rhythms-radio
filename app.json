{
  "expo": {
    "name": "Radio Collectif",
    "slug": "radio-collectif",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hidden-logo.png",
    "scheme": "radiocollectif",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F9F0C9",
        "foregroundImage": "./assets/images/hidden-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/hidden-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9F0C9",
          "image": "./assets/images/hidden-logo.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
